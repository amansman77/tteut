# See AGENTS.md#environment-variables for what each one does and how the
# app behaves when it's missing (everything here fails soft, not hard).

# 국립국어원 표준국어대사전(stdict) Open API — https://stdict.korean.go.kr
STDICT_API_KEY=your_stdict_api_key_here
STDICT_CERT_KEY_NO=9128

# Admin-only auth (protects /seed). SESSION_SECRET can be any random string.
SESSION_SECRET=your_random_session_secret_here
ADMIN_EMAIL=your_admin_email_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional: posts to a Discord channel on missing-word searches and new submissions
DISCORD_WEBHOOK_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
